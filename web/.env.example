# 이 파일을 .env로 복사해서 쓰세요. .env는 커밋되지 않습니다.
DATABASE_URL="postgresql://survey:devpassword@localhost:5432/survey?schema=public"

# 최초 관리자 계정 (seed 스크립트가 사용)
ADMIN_LOGIN_ID="admin"
ADMIN_INITIAL_PASSWORD="change-me-on-first-login"

# ── 백업 (docs/13-backup-restore.md) ──
# 덤프를 둘 곳. 안 적으면 web/backups
# BACKUP_DIR=
# DB 컨테이너 이름 — 이 안의 pg_dump 를 쓴다
# DB_CONTAINER=survey-db
# Docker 없이 호스트 pg_dump 를 쓸 때만
# BACKUP_DUMP_CMD=
